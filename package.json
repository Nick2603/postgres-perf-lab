{
  "name": "postgres-perf-lab",
  "version": "0.0.1",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:new": "dbmate new",
    "db:up": "dbmate up",
    "db:down": "dbmate rollback",
    "db:seed": "tsx src/scripts/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@fastify/env": "^7.0.0",
    "dbmate": "^2.34.1",
    "fastify": "^5.11.0",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.22.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
